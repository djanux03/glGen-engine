#version 460
#extension GL_GOOGLE_include_directive : require
#include "atmosphereData.glsl"
layout(set=0,binding=5,rgba16f) writeonly uniform image3D uHistoryOutput;
layout(local_size_x=4,local_size_y=4,local_size_z=4) in;
void main() {
    ivec3 cell=ivec3(gl_GlobalInvocationID),size=imageSize(uHistoryOutput);
    if(any(greaterThanEqual(cell,size))) return;
    vec4 value=texelFetch(uFogCurrent,cell,0);
    if(uAtmosphere.history.x>.5) {
        vec3 position=fogPosition((vec2(cell.xy)+.5)/vec2(size.xy),.5*(fogBoundary(float(cell.z))+fogBoundary(float(cell.z+1))));
        vec4 previous=uAtmosphere.prevViewProj*vec4(position,1);
        float depth=-(uAtmosphere.prevView*vec4(position,1)).z;
        // Histories store coefficients at slice centres, not accumulated boundaries.
        float previousSlice=fogSlice(max(depth,0.0));
        vec3 uvw=vec3(previous.xy/max(previous.w,1e-5)*.5+.5,previousSlice/float(size.z));
        if(previous.w>0&&depth>=0&&all(greaterThanEqual(uvw,vec3(0)))&&all(lessThanEqual(uvw,vec3(1)))) {
            vec4 lo=value,hi=value;
            for(int axis=0;axis<3;++axis) for(int sign=-1;sign<=1;sign+=2) {
                ivec3 neighbor=cell; neighbor[axis]+=sign;
                vec4 v=texelFetch(uFogCurrent,clamp(neighbor,ivec3(0),size-1),0);
                lo=min(lo,v); hi=max(hi,v);
            }
            vec4 old=texture(uFogHistory,uvw);
            float relative=abs(old.a-value.a)/max(value.a,1e-5);
            float weight=min(uAtmosphere.history.y,.9)*(1.0-smoothstep(.1,.5,relative));
            value=mix(value,clamp(old,lo,hi),weight);
        }
    }
    imageStore(uHistoryOutput,cell,value);
}
