#version 450
#extension GL_EXT_mesh_shader : require

// Task (amplification) shader: one workgroup per terrain patch. Frustum-culls
// the patch's AABB and only emits a mesh workgroup for visible patches — this
// is the GPU-driven culling that makes mesh-shader terrain worthwhile.
layout(local_size_x = 1) in;

layout(set = 1, binding = 0) uniform FrameData {
    mat4 viewProj;
    mat4 view;
    mat4 lightSpace[3];
    vec4 lightDir;
    vec4 cascadeSplits;
} uFrame;

struct Payload { uint patchIndex; };
taskPayloadSharedEXT Payload payload;

const uint kPatches = 24u;
const float kHalf = 12.0;
const float kPatchSize = (2.0 * kHalf) / float(kPatches);
const float kMinH = -0.8;
const float kMaxH = 1.0;

bool aabbVisible(vec3 lo, vec3 hi) {
    int outL = 0, outR = 0, outB = 0, outT = 0, outN = 0, outF = 0;
    for (int i = 0; i < 8; ++i) {
        vec3 c = vec3((i & 1) != 0 ? hi.x : lo.x,
                      (i & 2) != 0 ? hi.y : lo.y,
                      (i & 4) != 0 ? hi.z : lo.z);
        vec4 clip = uFrame.viewProj * vec4(c, 1.0);
        if (clip.x < -clip.w) ++outL;
        if (clip.x >  clip.w) ++outR;
        if (clip.y < -clip.w) ++outB;
        if (clip.y >  clip.w) ++outT;
        if (clip.z < 0.0)     ++outN;
        if (clip.z >  clip.w) ++outF;
    }
    return !(outL == 8 || outR == 8 || outB == 8 ||
             outT == 8 || outN == 8 || outF == 8);
}

void main() {
    uint patchId = gl_WorkGroupID.x;
    uint px = patchId % kPatches;
    uint pz = patchId / kPatches;
    vec2 origin = vec2(-kHalf) + vec2(px, pz) * kPatchSize;
    vec3 lo = vec3(origin.x, kMinH, origin.y);
    vec3 hi = vec3(origin.x + kPatchSize, kMaxH, origin.y + kPatchSize);

    payload.patchIndex = patchId;
    EmitMeshTasksEXT(aabbVisible(lo, hi) ? 1u : 0u, 1u, 1u);
}
